# Modèle des variables d'environnement attendues.
# Copiez ce fichier en `.env` et renseignez les valeurs : le `.env` n'est
# jamais versionné, celui-ci l'est — n'y mettez donc aucun secret réel.

# Venice AI — API de complétion compatible OpenAI (https://docs.venice.ai)
# Clé personnelle, à récupérer sur https://venice.ai
VENICE_API_KEY=
# Facultatif — valeurs par défaut du code si laissées vides :
#   https://api.venice.ai/api/v1
VENICE_BASE_URL=
#   zai-org-glm-5-2
VENICE_MODEL=

# Omkar.cloud — Airbnb + Booking (même clé ok_…, coffre Réglages prioritaire)
# OMKAR_API_KEY=
# OMKAR_AIRBNB_KEY=
# OMKAR_BOOKING_KEY=
# SKITRACK_PROXY=http://user:pass@brd.superproxy.io:33335
# SKITRACK_PROXY_LIST=
# SKITRACK_PROXY_MODE=residential
# BRIGHTDATA_RESIDENTIAL=
# BRIGHTDATA_RESIDENTIAL_ZONE=residential
# BRIGHTDATA_RESIDENTIAL_COUNTRY=fr
# BRIGHTDATA_BROWSER_WS=wss://brd-customer-…-zone-scraping_browser:pass@brd.superproxy.io:9222
# Crawlbase Crawling API (Booking, premier moteur)
# CRAWLBASE_TOKEN=
# CRAWLBASE_JS_TOKEN=
# ScrapingBee / booking-scraper-api (Booking)
# SCRAPINGBEE_API_KEY=


# Relevés isolés (un process Chromium par source). 1 = imposer les workers,
# 0 = toujours le process de l’app. Absent = workers s’ils répondent.
# SKITRACK_SCRAPE_DOCKER=
# SKITRACK_SCRAPE_URL_BOOKING_WEB=http://127.0.0.1:18701
# SKITRACK_SCRAPE_URL_GITES_WEB=http://127.0.0.1:18702
# SKITRACK_SCRAPE_URL_VRBO_WEB=http://127.0.0.1:18703
# SKITRACK_SCRAPE_URL_AIRBNB=http://127.0.0.1:18704
# SKITRACK_SCRAPE_URL_STATION_WEB=http://127.0.0.1:18705
# Airbnb pyairbnb (process Python isolé, image scrape/airbnb — pas de Chromium)
# SKITRACK_PYAIRBNB_PYTHON=
# SKITRACK_PYAIRBNB_CLI=
