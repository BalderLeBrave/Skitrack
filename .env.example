# Modèle des variables d'environnement attendues.
# Copiez ce fichier en `.env` et renseignez les valeurs : le `.env` n'est
# jamais versionné, celui-ci l'est — n'y mettez donc aucun secret réel.

# Venice AI — API de complétion compatible OpenAI (https://docs.venice.ai)
# Clé personnelle, à récupérer sur https://venice.ai
VENICE_API_KEY=
# Facultatif — valeurs par défaut du code si laissées vides :
#   https://api.venice.ai/api/v1
VENICE_BASE_URL=
#   zai-org-glm-5-2
VENICE_MODEL=
