# Modèle des variables d'environnement attendues.
# Copiez ce fichier en `.env` et renseignez les valeurs : le `.env` n'est
# jamais versionné, celui-ci l'est — n'y mettez donc aucun secret réel.

# Venice AI — API de complétion compatible OpenAI (https://docs.venice.ai)
# Clé personnelle, à récupérer sur https://venice.ai
VENICE_API_KEY=
# Facultatif — valeurs par défaut du code si laissées vides :
#   https://api.venice.ai/api/v1
VENICE_BASE_URL=
#   zai-org-glm-5-2
VENICE_MODEL=

# Omkar.cloud — Airbnb + Booking (même clé ok_…, coffre Réglages prioritaire)
# OMKAR_API_KEY=
# OMKAR_AIRBNB_KEY=
# OMKAR_BOOKING_KEY=
# SKITRACK_PROXY=http://user:pass@brd.superproxy.io:33335
# SKITRACK_PROXY_LIST=
# SKITRACK_PROXY_MODE=residential
# BRIGHTDATA_RESIDENTIAL=
# BRIGHTDATA_RESIDENTIAL_ZONE=residential
# BRIGHTDATA_RESIDENTIAL_COUNTRY=fr
# BRIGHTDATA_BROWSER_WS=wss://brd-customer-…-zone-scraping_browser:pass@brd.superproxy.io:9222

