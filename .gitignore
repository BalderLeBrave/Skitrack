# Tuiles OpenSkiMap : 135 Mo, bâties par scripts/build-tuiles-openskimap.ts,
# hébergées hors du dépôt (voir docs/TUILES-OPENSKIMAP.md).
public/carte/*.pmtiles

# Venv des workers Python de relevé (npm run scrape:python).
scrape/.venv/

# Journal local, écrit à la main dans le dossier du dépôt.
app.log

# Dossiers de travail des relevés (docs/WEBCAMS.md, docs/PISTES-DETAIL.md).
# Sauf les voies OSM de chaque station (scripts/build-reseau-pieton.mjs) :
# versionnées, elles redonnent public/reseau-* sans réseau ni extraits.
travail/*
!travail/reseau-pieton/

# Captures de scripts/recette.mjs (sa sortie par défaut).
docs/recette/captures/

# Python embarqué dans l'installateur Windows (scripts/preparer-python-embarque.mjs).
build/python/
build/python-cache/
# Navigateur de Playwright embarqué dans l'installateur (scripts/preparer-navigateur.mjs).
build/ms-playwright/
# Tuiles de la carte pour l'installateur : bâties là, ou copiées depuis
# public/carte par scripts/release-win.mjs, qui y met aussi de côté celles de
# public/carte le temps de vite build.
build/carte/
build/.public-carte-*
