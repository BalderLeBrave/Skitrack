out/
dist/
release/
openapi.json

# Sidecar Python
sidecar/.venv/
sidecar/**/__pycache__/
sidecar/*.egg-info/
sidecar/.pytest_cache/
*.pyc

# Données locales — jamais versionnées : la base contient les recherches et le
# coffre contient des clés d'API chiffrées.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
secrets.enc.json
data/cache/
.env
.env.local

.vscode/
.idea/
Thumbs.db

*.tsbuildinfo

.claude/worktrees/

# Tampon du portail de fin de tour (.claude/hooks/verify.mjs) : un état local,
# propre à la machine, qui n'a pas à voyager avec le dépôt.
.claude/.verify-stamp

.tmp-repro/

# Binaire Obscura (~70 Mo) — `npm run obscura:fetch`
# Le zip Windows livre aussi obscura-worker.exe (74 Mo) : sans ces deux
# lignes, il restait suivi par Git et un `git add -A` l'aurait commité.
vendor/obscura/obscura
vendor/obscura/obscura.exe
vendor/obscura/obscura-worker
vendor/obscura/obscura-worker.exe
vendor/obscura/*.tar.gz
vendor/obscura/*.zip


graphify-out/
*.graphify-bak
