node_modules/
out/
dist/
# Sortie du build d’aperçu navigateur (vite.preview.config.ts), régénérée
# par scripts/preview-serve.sh : elle était versionnée, 334 fichiers.
dist-preview/
release/
openapi.json

# Sidecar Python
sidecar/.venv/
sidecar/**/__pycache__/
sidecar/*.egg-info/
sidecar/.pytest_cache/
*.pyc

# Données locales — jamais versionnées : la base contient les recherches et le
# coffre contient des clés d'API chiffrées.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
secrets.enc.json
data/cache/
.env
.env.local

.vscode/
.idea/
Thumbs.db

*.tsbuildinfo

.claude/worktrees/

# Tampon du portail de fin de tour (.claude/hooks/verify.mjs) : un état local,
# propre à la machine, qui n'a pas à voyager avec le dépôt.
.claude/.verify-stamp

.tmp-repro/

graphify-out/
.claude/settings.json.graphify-bak
vendor/
.env.*
*.env
credentials.json
*.pem
*.key
.credentials

# Le modèle des variables, lui, est versionné : il ne contient aucune valeur.
!.env.example

# Caches d'outils, régénérés à chaque exécution : ils n'ont pas à voyager avec
# le dépôt, et leur absence du fichier les rendait visibles à chaque `git status`.
.ruff_cache/
__pycache__/
tools/extract-listings/.venv/
tools/extract-listings/out/
