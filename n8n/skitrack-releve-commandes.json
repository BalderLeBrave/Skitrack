        "jsCode": "const centrales = $('Centrales sans connecteur').first().json;\nconst forfaits = $('Pages tarifs des domaines').first().json;\nconst derniere = (t) => (t || '').trim().split('\\n').filter(Boolean).slice(-12).join('\\n');\nreturn [{ json: {\n  releveLe: new Date().toISOString(),\n  centrales: { code: centrales.exitCode, sortie: derniere(centrales.stdout), erreur: derniere(centrales.stderr) },\n  forfaits: { code: forfaits.exitCode, sortie: derniere(forfaits.stdout), erreur: derniere(forfaits.stderr) },\n} }];"
