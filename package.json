{
  "name": "skitrack",
  "version": "0.1.0",
  "description": "Recherche et comparaison de locations de vacances au ski, par domaine skiable et altitude réelle des pistes.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Adrien RAFFRAY",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "package": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap.ps1",
    "sidecar:test": "sidecar/.venv/Scripts/python.exe -m pytest sidecar/tests -q",
    "sidecar:import": "sidecar/.venv/Scripts/python.exe -m skitrack.cli import --countries FR",
    "sidecar:stats": "sidecar/.venv/Scripts/python.exe -m skitrack.cli stats",
    "gen:types": "node scripts/gen-types.mjs",
    "verify": "npm run typecheck:web && npm run i18n:test && npm run stations:test && npm run cards:test && npm run i18n:scan -- --ci",
    "cards:test": "esbuild src/renderer/src/components/ResultCard.test.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=node_modules/.cache/cards-test.cjs --log-level=error && node node_modules/.cache/cards-test.cjs",
    "stations:test": "esbuild src/renderer/src/data/stations.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/stations-test.mjs --alias:@=./src/renderer/src --log-level=error && node node_modules/.cache/stations-test.mjs",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "i18n:test": "esbuild src/renderer/src/i18n/catalog.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/i18n-test.mjs --log-level=error && node node_modules/.cache/i18n-test.mjs",
    "i18n:scan": "node scripts/scan-untranslated.mjs",
    "providers:test": "esbuild src/main/providers/providers.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/providers-test.mjs --external:electron --alias:@shared=./src/shared --log-level=error && node node_modules/.cache/providers-test.mjs"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "electron-updater": "^6.3.9",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@types/geojson": "^7946.0.15",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "maplibre-gl": "^4.7.1",
    "openapi-typescript": "^7.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
