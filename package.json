{
  "name": "skitrack",
  "version": "0.1.0",
  "description": "Recherche et comparaison de locations de vacances au ski, par domaine skiable et altitude r\u00e9elle des pistes.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Adrien RAFFRAY",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "package": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap.ps1",
    "sidecar:test": "sidecar\\.venv\\Scripts\\python.exe -m pytest sidecar/tests -q",
    "sidecar:import": "sidecar\\.venv\\Scripts\\python.exe -m skitrack.cli import --countries FR",
    "sidecar:stats": "sidecar\\.venv\\Scripts\\python.exe -m skitrack.cli stats",
    "gen:types": "node scripts/gen-types.mjs",
    "catalogue:import": "node tools/import-france-montagnes.mjs",
    "centrales:import": "node tools/import-centrales.mjs",
    "robots:test": "esbuild src/main/providers/station/robots.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/robots-test.mjs --log-level=error && node node_modules/.cache/robots-test.mjs",
    "ingenie:price-test": "esbuild src/main/providers/station/fichePrice.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fiche-price-test.mjs --log-level=error && node node_modules/.cache/fiche-price-test.mjs",
    "families:test": "esbuild src/shared/bookingFamilies.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/families-test.mjs --log-level=error && node node_modules/.cache/families-test.mjs",
    "centrales:recon": "node tools/recon-centrales.mjs",
    "centrales:sweep": "esbuild tools/sweep-centrales.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/centrales-sweep.mjs --external:playwright --alias:@main=./src/main --alias:@shared=./src/shared --alias:@=./src/renderer/src --alias:electron=./tools/lib/electron-stub.mjs --log-level=error && node node_modules/.cache/centrales-sweep.mjs",
    "lint:py": "sidecar\\.venv\\Scripts\\python.exe -m ruff check sidecar",
    "verify": "npm run typecheck:web && npm run i18n:test && npm run stations:test && npm run places:test && npm run areas:test && npm run avail:test && npm run lodgfilter:test && npm run accesstime:test && npm run cards:test && npm run robots:test && npm run ingenie:price-test && npm run families:test && npm run providers:test && npm run ublo:parse-test && npm run ublourl:test && npm run occupancy:test && npm run opensystem:parse-test && npm run locvacances:parse-test && npm run i18n:scan -- --ci",
    "cards:test": "esbuild src/renderer/src/components/ResultCard.test.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=node_modules/.cache/cards-test.cjs --log-level=error && node node_modules/.cache/cards-test.cjs",
    "stations:test": "esbuild src/renderer/src/data/stations.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/stations-test.mjs --alias:@=./src/renderer/src --log-level=error && node node_modules/.cache/stations-test.mjs",
    "refs:audit": "esbuild src/renderer/src/data/coverage.audit.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/coverage-audit.mjs --alias:@=./src/renderer/src --log-level=error && node node_modules/.cache/coverage-audit.mjs",
    "areas:audit": "esbuild src/renderer/src/data/skiAreas.audit.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/areas-audit.mjs --alias:@=./src/renderer/src --log-level=error && node node_modules/.cache/areas-audit.mjs",
    "areas:test": "esbuild src/renderer/src/data/skiAreas.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/areas-test.mjs --alias:@=./src/renderer/src --log-level=error && node node_modules/.cache/areas-test.mjs",
    "avail:test": "esbuild src/renderer/src/data/lodgingAvailability.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/avail-test.mjs --alias:@=./src/renderer/src --log-level=error && node node_modules/.cache/avail-test.mjs",
    "accesstime:test": "esbuild src/renderer/src/data/accessTime.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/accesstime-test.mjs --alias:@=./src/renderer/src --log-level=error && node node_modules/.cache/accesstime-test.mjs",
    "lodgfilter:test": "esbuild src/renderer/src/data/lodgingFilter.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/lodgfilter-test.mjs --alias:@=./src/renderer/src --log-level=error && node node_modules/.cache/lodgfilter-test.mjs",
    "places:test": "esbuild src/renderer/src/data/places.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/places-test.mjs --alias:@=./src/renderer/src --log-level=error && node node_modules/.cache/places-test.mjs",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "i18n:test": "esbuild src/renderer/src/i18n/catalog.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/i18n-test.mjs --log-level=error && node node_modules/.cache/i18n-test.mjs",
    "i18n:scan": "node scripts/scan-untranslated.mjs",
    "providers:test": "esbuild src/main/providers/providers.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/providers-test.cjs --external:electron --external:playwright --alias:@shared=./src/shared --log-level=error && node node_modules/.cache/providers-test.cjs",
    "deploy:github": "node scripts/deploy-github.mjs",
    "chamonix:extract": "node tools/extract-chamonix.mjs",
    "ceto:parse-test": "esbuild src/main/providers/ceto/chamonixParse.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ceto-parse-test.mjs --log-level=error --loader:.html=text && node node_modules/.cache/ceto-parse-test.mjs",
    "occupancy:test": "esbuild src/main/providers/ceto/occupancy.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/occupancy-test.mjs --log-level=error --external:playwright && node node_modules/.cache/occupancy-test.mjs",
    "ublourl:test": "esbuild src/shared/ubloUrl.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ublourl-test.mjs --log-level=error && node node_modules/.cache/ublourl-test.mjs",
    "ublo:parse-test": "esbuild src/main/providers/ublo/msem.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ublo-msem-test.mjs --log-level=error --loader:.json=json --alias:@shared=./src/shared && node node_modules/.cache/ublo-msem-test.mjs",
    "opensystem:parse-test": "esbuild src/main/providers/opensystem/parse.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/os-parse-test.mjs --log-level=error --loader:.html=text --loader:.js=text && node node_modules/.cache/os-parse-test.mjs",
    "locvacances:parse-test": "esbuild src/main/providers/locvacances/parse.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/locvacances-test.mjs --log-level=error && node node_modules/.cache/locvacances-test.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "electron-updater": "^6.3.9",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@types/geojson": "^7946.0.15",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "maplibre-gl": "^4.7.1",
    "openapi-typescript": "^7.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
