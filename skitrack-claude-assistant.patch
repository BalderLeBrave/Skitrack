+import { createServerFn } from "@tanstack/react-start";
+import { z } from "zod";
+
+const Turn = z.object({
+  role: z.enum(["user", "assistant"]),
+  content: z.string().min(1).max(4000),
+});
+
+const Input = z.object({
+  messages: z.array(Turn).min(1).max(40),
+  mode: z.enum(["chat", "summary", "recommend"]).optional(),
+});
+
+export type AssistantReply = { reply: string };
+
+/**
+ * Assistant ski Claude (Sonnet 5). Multi-tour : le client renvoie tout
+ * l'historique à chaque appel, le serveur reste sans état.
+ */
+export const askSki = createServerFn({ method: "POST" })
+  .validator(Input)
+  .handler(async ({ data }): Promise<AssistantReply> => {
+    const { rateLimit, clientKey, RateLimitError } = await import("@/lib/serverRate.server");
+    if (!rateLimit(`ai:${clientKey()}`, 15, 60_000)) throw new RateLimitError();
+
+    const { claudeComplete } = await import("@/lib/ai/emergent.server");
+    const { buildSystemPrompt } = await import("@/lib/ai/context.server");
+
+    const mode = data.mode ?? "chat";
+    const messages = [
+      { role: "system" as const, content: buildSystemPrompt(mode) },
+      ...data.messages,
+    ];
+    const reply = await claudeComplete(messages, {
+      maxTokens: mode === "summary" ? 1200 : 900,
+    });
+    return { reply };
+  });
