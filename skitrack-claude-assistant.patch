+import { useEffect, useRef, useState } from "react";
+import { X, Send, Sparkles } from "lucide-react";
+import { askSki } from "@/lib/ai/api";
+
+type Turn = { role: "user" | "assistant"; content: string };
+
+const SUGGESTIONS = [
+  "Recommande-moi une station de haute altitude en Savoie pour février.",
+  "Quelle station a le plus grand domaine skiable relié ?",
+  "Résume les points forts d'un séjour aux Deux Alpes.",
+];
+
+const GREETING =
+  "Bonjour \u2744\ufe0f Je suis l'assistant ski de Skitrack. Posez-moi une question sur les stations françaises, demandez une recommandation ou un résumé de séjour.";
+
+export function SkiAssistant() {
+  const [open, setOpen] = useState(false);
+  const [messages, setMessages] = useState<Turn[]>([]);
+  const [input, setInput] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const scroller = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    scroller.current?.scrollTo({ top: scroller.current.scrollHeight, behavior: "smooth" });
+  }, [messages, busy]);
+
+  const send = async (text: string) => {
+    const clean = text.trim();
+    if (!clean || busy) return;
+    setError(null);
+    const next: Turn[] = [...messages, { role: "user", content: clean }];
+    setMessages(next);
+    setInput("");
+    setBusy(true);
+    try {
+      const res = await askSki({ data: { messages: next } });
+      setMessages((cur) => [...cur, { role: "assistant", content: res.reply }]);
+    } catch (err) {
+      const msg = err instanceof Error ? err.message : String(err);
+      setError(msg);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <>
+      {!open ? (
+        <button
+          type="button"
+          data-testid="skiassistant-open"
+          onClick={() => setOpen(true)}
+          aria-label="Ouvrir l'assistant ski"
+          className="fixed bottom-5 right-5 z-40 flex items-center gap-2 rounded-full bg-glacier px-4 py-3 font-display text-sm text-ink shadow-lg ring-1 ring-black/10 transition-transform duration-200 hover:-translate-y-0.5"
+        >
+          <Sparkles size={18} aria-hidden="true" />
+          Assistant ski
+        </button>
+      ) : null}
+
+      {open ? (
+        <div
+          data-testid="skiassistant-panel"
+          className="fixed bottom-5 right-5 z-40 flex h-[min(70vh,560px)] w-[min(92vw,380px)] flex-col overflow-hidden rounded-2xl border border-line bg-panel text-ink shadow-2xl"
+          role="dialog"
+          aria-label="Assistant ski Skitrack"
+        >
+          <header className="flex items-center justify-between border-b border-line px-4 py-3">
+            <span className="flex items-center gap-2 font-display">
+              <Sparkles size={18} aria-hidden="true" />
+              Assistant ski
+            </span>
+            <button
+              type="button"
+              data-testid="skiassistant-close"
+              onClick={() => setOpen(false)}
+              aria-label="Fermer l'assistant"
+              className="rounded-full p-1 text-muted hover:text-ink"
+            >
+              <X size={18} aria-hidden="true" />
+            </button>
+          </header>
+
+          <div
+            ref={scroller}
+            data-testid="skiassistant-messages"
+            className="flex-1 space-y-3 overflow-y-auto px-4 py-3 text-sm"
+          >
+            <p className="rounded-xl bg-bg/60 px-3 py-2 text-muted">{GREETING}</p>
+            {messages.map((m, i) => (
+              <div
+                key={i}
+                className={m.role === "user" ? "flex justify-end" : "flex justify-start"}
+              >
+                <p
+                  className={`max-w-[85%] whitespace-pre-wrap rounded-xl px-3 py-2 ${
+                    m.role === "user" ? "bg-glacier text-ink" : "bg-bg/60 text-ink"
+                  }`}
+                >
+                  {m.content}
+                </p>
+              </div>
+            ))}
+            {busy ? (
+              <p className="text-muted" data-testid="skiassistant-loading">
+                L'assistant réfléchit…
+              </p>
+            ) : null}
+            {error ? (
+              <p className="rounded-xl bg-red-500/10 px-3 py-2 text-red-600" data-testid="skiassistant-error">
+                {error}
+              </p>
+            ) : null}
+          </div>
+
+          {messages.length === 0 ? (
+            <div className="flex flex-wrap gap-2 px-4 pb-2">
+              {SUGGESTIONS.map((s) => (
+                <button
+                  key={s}
+                  type="button"
+                  onClick={() => send(s)}
+                  className="rounded-full border border-line px-3 py-1 text-left text-xs text-muted hover:bg-bg/60"
+                >
+                  {s}
+                </button>
+              ))}
+            </div>
+          ) : null}
+
+          <form
+            className="flex items-center gap-2 border-t border-line px-3 py-3"
+            onSubmit={(e) => {
+              e.preventDefault();
+              void send(input);
+            }}
+          >
+            <input
+              data-testid="skiassistant-input"
+              value={input}
+              onChange={(e) => setInput(e.target.value)}
+              placeholder="Votre question ski…"
+              className="min-w-0 flex-1 rounded-full border border-line bg-bg px-4 py-2 text-sm outline-none focus:border-glacier"
+              disabled={busy}
+            />
+            <button
+              type="submit"
+              data-testid="skiassistant-send"
+              disabled={busy || !input.trim()}
+              aria-label="Envoyer"
+              className="rounded-full bg-glacier p-2 text-ink disabled:opacity-40"
+            >
+              <Send size={18} aria-hidden="true" />
+            </button>
+          </form>
+        </div>
+      ) : null}
+    </>
+  );
+}
