+/**
+ * Client Claude (server-only) via la passerelle LLM Emergent.
+ *
+ * La passerelle est OpenAI-compatible : on POST sur `${PROXY}/llm/chat/completions`
+ * avec `Authorization: Bearer <EMERGENT_LLM_KEY>` et un corps au format OpenAI
+ * (`{ model, messages }`). Le modèle est nommé directement (`claude-sonnet-5`).
+ *
+ * NE JAMAIS importer depuis le client : la clé ne doit jamais atteindre le
+ * navigateur. Appeler uniquement depuis un handler `createServerFn`.
+ */
+
+const PROXY = (
+  process.env.INTEGRATION_PROXY_URL ??
+  process.env.integration_proxy_url ??
+  "https://integrations.emergentagent.com"
+).replace(/\/+$/, "");
+
+const KEY = process.env.EMERGENT_LLM_KEY?.trim();
+
+/** Identifiant d'app facultatif, utilisé par la passerelle pour l'attribution. */
+const APP_ID = process.env.APP_URL?.trim() || process.env.REACT_APP_BACKEND_URL?.trim();
+
+/** Modèle par défaut choisi par l'utilisateur. */
+export const CLAUDE_MODEL = "claude-sonnet-5";
+
+export type ChatRole = "system" | "user" | "assistant";
+export type ChatMsg = { role: ChatRole; content: string };
+
+export class LlmKeyError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "LlmKeyError";
+  }
+}
+
+type Completion = {
+  choices?: { message?: { content?: string | { text?: string }[] } }[];
+};
+
+function readContent(data: Completion): string {
+  const content = data.choices?.[0]?.message?.content;
+  if (typeof content === "string") return content;
+  if (Array.isArray(content)) return content.map((c) => c?.text ?? "").join("");
+  return "";
+}
+
+/**
+ * Une complétion Claude, non-streaming. Renvoie le texte de la réponse.
+ * Lève `LlmKeyError` si la clé est absente/inactive pour un message clair côté UI.
+ */
+export async function claudeComplete(
+  messages: ChatMsg[],
+  opts: { model?: string; maxTokens?: number; temperature?: number } = {},
+): Promise<string> {
+  if (!KEY) {
+    throw new LlmKeyError(
+      "EMERGENT_LLM_KEY absente. Renseignez la clé Universal Emergent dans l'environnement.",
+    );
+  }
+  const res = await fetch(`${PROXY}/llm/chat/completions`, {
+    method: "POST",
+    headers: {
+      "Content-Type": "application/json",
+      Authorization: `Bearer ${KEY}`,
+      ...(APP_ID ? { "X-App-ID": APP_ID } : {}),
+    },
+    body: JSON.stringify({
+      model: opts.model ?? CLAUDE_MODEL,
+      messages,
+      max_tokens: opts.maxTokens ?? 900,
+      temperature: opts.temperature ?? 0.4,
+    }),
+  });
+
+  if (!res.ok) {
+    const body = (await res.text()).slice(0, 400);
+    if (res.status === 401 || res.status === 403 || /inactive|invalid api key/i.test(body)) {
+      throw new LlmKeyError(
+        "Clé Universal Emergent inactive. Activez-la (Profile → Manage plan → Universal Key → Add Balance).",
+      );
+    }
+    throw new Error(`Passerelle LLM ${res.status} : ${body}`);
+  }
+
+  const data = (await res.json()) as Completion;
+  const text = readContent(data).trim();
+  if (!text) throw new Error("Réponse vide du modèle.");
+  return text;
+}
