+/**
+ * Contexte métier (server-only) injecté dans le prompt système de l'assistant.
+ * On embarque un catalogue compact des stations pour l'aide à la décision, et on
+ * cadre le ton : France uniquement, aucune donnée inventée (même contrat que le
+ * reste de Skitrack).
+ */
+import { STATIONS } from "@/lib/stations";
+
+let catalogCache: string | null = null;
+
+/** Une ligne compacte par station : nom, massif, altitudes, km annoncés. */
+export function stationCatalog(): string {
+  if (catalogCache) return catalogCache;
+  const lines = STATIONS.map((s) => {
+    const km = s.pistesKm ?? s.slopes.announcedKm ?? null;
+    const kmPart = km && km > 0 ? `, ~${Math.round(km)} km` : "";
+    return `- ${s.name} (${s.massif}) : village ${s.villageM || "?"} m, domaine ${s.minM}\u2013${s.maxM} m${kmPart}`;
+  });
+  catalogCache = lines.join("\n");
+  return catalogCache;
+}
+
+export type AssistantMode = "chat" | "summary" | "recommend";
+
+const BASE = `Tu es l'assistant ski de Skitrack, une application de comparaison de séjours au ski en France.
+
+Règles absolues :
+- France uniquement. Tu ne parles que de stations et domaines skiables français.
+- N'invente RIEN. Si une donnée précise (prix de forfait du jour, hauteur de neige en temps réel, bulletin d'avalanche BRA) n'est pas fournie dans la conversation, dis clairement que Skitrack l'affiche dans l'app et ne devine pas un chiffre.
+- Les altitudes que tu cites viennent du catalogue ci-dessous (France Montagnes). Ne cite pas d'altitude qui n'y figure pas.
+- Réponds en français, de façon concise et concrète. Utilise des listes courtes quand c'est utile.
+- Tu aides à : (1) répondre aux questions ski, (2) recommander une station selon des critères (altitude, taille du domaine, massif, niveau des pistes, glacier), (3) résumer un séjour ou un comparatif de stations.
+
+Catalogue des stations (référentiel Skitrack) :
+`;
+
+export function buildSystemPrompt(mode: AssistantMode = "chat"): string {
+  const extra =
+    mode === "summary"
+      ? "\n\nTâche : produis un résumé clair et structuré du séjour/comparatif fourni, en mettant en avant altitude réelle du domaine, taille, points forts et réserves. Pas de superlatifs marketing."
+      : mode === "recommend"
+        ? "\n\nTâche : recommande 2 à 4 stations classées, avec en une phrase pourquoi chacune correspond aux critères. Termine en invitant l'utilisateur à ouvrir la fiche station dans Skitrack pour les logements et forfaits à jour."
+        : "";
+  return BASE + stationCatalog() + extra;
+}
