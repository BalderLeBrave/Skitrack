+/**
+ * Limiteur de débit en mémoire (server-only), best-effort.
+ *
+ * Efficace sur un hôte Node persistant (le compteur est partagé par le process).
+ * En serverless éphémère il ne protège qu'à l'échelle d'une instance chaude —
+ * pour une vraie protection multi-instances, adosser à Redis/Upstash.
+ */
+import { getRequest } from "@tanstack/react-start/server";
+
+const hits = new Map<string, number[]>();
+
+/** Retourne false si `key` a dépassé `max` appels dans la fenêtre `windowMs`. */
+export function rateLimit(key: string, max: number, windowMs: number): boolean {
+  const now = Date.now();
+  const recent = (hits.get(key) ?? []).filter((t) => now - t < windowMs);
+  if (recent.length >= max) {
+    hits.set(key, recent);
+    return false;
+  }
+  recent.push(now);
+  hits.set(key, recent);
+  return true;
+}
+
+/** Clé d'appelant depuis l'IP (x-forwarded-for), sinon "anon". */
+export function clientKey(): string {
+  try {
+    const req = getRequest();
+    const fwd = req?.headers.get("x-forwarded-for") ?? "";
+    const ip = fwd.split(",")[0]?.trim();
+    return ip || "anon";
+  } catch {
+    return "anon";
+  }
+}
+
+export class RateLimitError extends Error {
+  readonly status = 429;
+  constructor(message = "Trop de requêtes. Réessayez dans un instant.") {
+    super(message);
+    this.name = "RateLimitError";
+  }
+}
