+/* ── Carte des logements (façon Airbnb) ─────────────────────────────────────
+   Liste à gauche, carte collante à droite. Une pastille-prix par annonce
+   géolocalisée ; survol et clic synchronisés avec les cartes de la liste. */
+.v6 .lodging__split {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 440px;
+  gap: 20px;
+  align-items: start;
+}
+.v6 .lodging__split .lodges {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+.v6 .lodging__map {
+  position: sticky;
+  top: 0;
+  height: calc(100vh - 168px);
+  min-height: 460px;
+  border-radius: 16px;
+  overflow: hidden;
+  border: 1px solid var(--bordure-douce);
+  box-shadow: var(--shadow);
+  background: var(--v6-carte-fond);
+}
+.v6 .lodge-map {
+  position: absolute;
+  inset: 0;
+}
+.v6 .lodge.hover {
+  border-color: var(--marque);
+}
+.v6 .lodge-pin {
+  display: inline-flex;
+  align-items: center;
+  transform: translate(-50%, -50%);
+  padding: 4px 9px;
+  border-radius: 999px;
+  background: var(--v6-surface);
+  color: var(--ink);
+  font-size: 12.5px;
+  font-weight: 700;
+  border: 1px solid var(--bordure);
+  box-shadow: var(--v6-shadow-pin);
+  white-space: nowrap;
+  cursor: pointer;
+  transition:
+    transform 0.12s,
+    background 0.12s,
+    color 0.12s;
+  font-variant-numeric: tabular-nums;
+}
+.v6 .lodge-pin:hover,
+.v6 .lodge-pin.hover {
+  background: var(--ink);
+  color: var(--v6-blanc);
+  border-color: var(--ink);
+}
+.v6 .lodge-pin.on {
+  background: var(--cta);
+  color: var(--v6-blanc);
+  border-color: var(--cta);
+  transform: translate(-50%, -50%) scale(1.08);
+}
+.v6 .lodge-station {
+  width: 16px;
+  height: 16px;
+  border-radius: 50%;
+  background: var(--marque);
+  border: 3px solid var(--v6-blanc);
+  box-shadow: var(--v6-shadow-pin);
+  transform: translate(-50%, -50%);
+}
+@media (max-width: 1100px) {
+  .v6 .lodging__split {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .v6 .lodging__split .lodges {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .v6 .lodging__map {
+    position: static;
+    height: 60vh;
+    min-height: 360px;
+  }
+}
+
 /* ── Réservation ────────────────────────────────────────────────────────── */
 .v6 .bgrid {
   display: grid;
