+  box-shadow: var(--shadow);
+  background: var(--v6-carte-fond);
+}
+.v6 .lodge-map {
+  position: absolute;
+  inset: 0;
+}
+.v6 .lodge.hover {
+  border-color: var(--marque);
+}
+.v6 .lodge-pin {
+  display: inline-flex;
+  align-items: center;
