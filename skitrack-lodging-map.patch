+    color 0.12s;
+  font-variant-numeric: tabular-nums;
+}
+.v6 .lodge-pin:hover,
+.v6 .lodge-pin.hover {
+  background: var(--ink);
+  color: var(--v6-blanc);
+  border-color: var(--ink);
+}
+.v6 .lodge-pin.on {
+  background: var(--cta);
+  color: var(--v6-blanc);
+  border-color: var(--cta);
+  transform: translate(-50%, -50%) scale(1.08);
+}
+.v6 .lodge-station {
+  width: 16px;
+  height: 16px;
+  border-radius: 50%;
+  background: var(--marque);
+  border: 3px solid var(--v6-blanc);
+  box-shadow: var(--v6-shadow-pin);
+  transform: translate(-50%, -50%);
+}
+@media (max-width: 1100px) {
+  .v6 .lodging__split {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .v6 .lodging__split .lodges {
+    grid-template-columns: minmax(0, 1fr);
+  }
+  .v6 .lodging__map {
+    position: static;
+    height: 60vh;
+    min-height: 360px;
+  }
+}
+
 /* ── Réservation ────────────────────────────────────────────────────────── */
 .v6 .bgrid {
   display: grid;
