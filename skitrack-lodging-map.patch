diff --git a/src/components/LodgeMap.tsx b/src/components/LodgeMap.tsx
new file mode 100644
index 0000000..be7ec24
--- /dev/null
+++ b/src/components/LodgeMap.tsx
@@ -0,0 +1,152 @@
+/** Carte des logements, façon Airbnb : une pastille-prix par annonce géolocalisée,
+ *  survol et clic synchronisés avec la liste, épingle station au centre et cercle
+ *  des 5 km (aucune annonce n'est affichée au-delà — filtre posé dans la route).
+ *
+ *  Leaflet lit `window` à l'évaluation : chargé à la demande depuis un effet,
+ *  comme `StationMap`, pour ne pas casser le rendu serveur. */
+
+import type * as Leaflet from "leaflet";
+import "leaflet/dist/leaflet.css";
+import { useEffect, useRef, useState } from "react";
+
+const TILES = "https://tile.openstreetmap.org/{z}/{x}/{y}.png";
+const ATTRIBUTION = "© OpenStreetMap contributors";
+const RADIUS_M = 5000;
+
+let leafletLoad: Promise<typeof Leaflet> | null = null;
+function loadLeaflet(): Promise<typeof Leaflet> {
+  leafletLoad ??= import("leaflet").then(
+    (m) =>
+      (m as unknown as { default?: typeof Leaflet }).default ?? (m as unknown as typeof Leaflet),
+  );
+  return leafletLoad;
+}
+
+export type LodgePin = {
+  id: string;
+  lat: number;
+  lon: number;
+  label: string;
+  title: string;
+};
+
+export function LodgeMap({
+  center,
+  stationName,
+  pins,
+  active,
+  hover,
+  onHover,
+  onSelect,
+}: {
+  center: { lat: number; lon: number };
+  stationName: string;
+  pins: LodgePin[];
+  active: string | null;
+  hover: string | null;
+  onHover: (id: string | null) => void;
+  onSelect: (id: string) => void;
+}) {
+  const host = useRef<HTMLDivElement>(null);
+  const lib = useRef<typeof Leaflet | null>(null);
+  const map = useRef<Leaflet.Map | null>(null);
+  const markers = useRef<Map<string, Leaflet.Marker>>(new Map());
+  const handlers = useRef({ onHover, onSelect });
+  handlers.current = { onHover, onSelect };
+  const [ready, setReady] = useState(0);
+
+  // Création de la carte : centre station, cercle des 5 km, zoom en bas à droite.
+  useEffect(() => {
+    let cancelled = false;
+    let teardown: (() => void) | null = null;
+    void loadLeaflet().then((Lf) => {
+      if (cancelled || !host.current) return;
+      lib.current = Lf;
+      const m = Lf.map(host.current, { zoomControl: false, scrollWheelZoom: true }).setView(
+        [center.lat, center.lon],
+        13,
+      );
+      Lf.tileLayer(TILES, { attribution: ATTRIBUTION, maxZoom: 18 }).addTo(m);
+      Lf.control.zoom({ position: "bottomright" }).addTo(m);
+      Lf.circle([center.lat, center.lon], {
+        radius: RADIUS_M,
+        color: "#2f6df0",
+        weight: 1,
+        opacity: 0.5,
+        fillColor: "#2f6df0",
+        fillOpacity: 0.05,
+      }).addTo(m);
+      Lf.marker([center.lat, center.lon], {
+        icon: Lf.divIcon({
+          className: "",
+          html: `<div class="lodge-station" title="${stationName}"></div>`,
+          iconSize: [16, 16],
+          iconAnchor: [8, 8],
+        }),
+        interactive: false,
+        zIndexOffset: -1000,
+      }).addTo(m);
+      const ro = new ResizeObserver(() => m.invalidateSize({ pan: false }));
+      ro.observe(host.current);
+      setTimeout(() => m.invalidateSize(), 0);
+      map.current = m;
+      teardown = () => {
+        ro.disconnect();
+        markers.current.clear();
+        m.remove();
+        map.current = null;
+      };
+      setReady((n) => n + 1);
+    });
+    return () => {
+      cancelled = true;
+      teardown?.();
+    };
+    // Vue initiale seulement ; le recentrage suit dans l'effet des pastilles.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  // Pastilles-prix : reconstruites à chaque changement de liste.
+  useEffect(() => {
+    const m = map.current;
+    const Lf = lib.current;
+    if (!m || !Lf) return;
+    markers.current.forEach((mk) => mk.remove());
+    markers.current.clear();
+    for (const p of pins) {
+      if (!Number.isFinite(p.lat) || !Number.isFinite(p.lon)) continue;
+      const marker = Lf.marker([p.lat, p.lon], {
+        icon: Lf.divIcon({
+          className: "",
+          html: `<span class="lodge-pin" data-id="${p.id}">${p.label}</span>`,
+          iconSize: [0, 0],
+        }),
+      }).addTo(m);
+      marker.on("mouseover", () => handlers.current.onHover(p.id));
+      marker.on("mouseout", () => handlers.current.onHover(null));
+      marker.on("click", () => handlers.current.onSelect(p.id));
+      markers.current.set(p.id, marker);
+    }
+    const pts = pins.filter((p) => Number.isFinite(p.lat) && Number.isFinite(p.lon));
+    if (pts.length > 0) {
+      const bounds = Lf.latLngBounds(pts.map((p) => [p.lat, p.lon] as [number, number]));
+      bounds.extend([center.lat, center.lon]);
+      m.fitBounds(bounds, { padding: [48, 48], maxZoom: 15 });
+    } else {
+      m.setView([center.lat, center.lon], 13);
+    }
+  }, [pins, center.lat, center.lon, ready]);
+
+  // Surbrillance active / survol.
+  useEffect(() => {
+    markers.current.forEach((marker, id) => {
+      const el = marker.getElement()?.querySelector(".lodge-pin");
+      if (!el) return;
+      el.classList.toggle("on", id === active);
+      el.classList.toggle("hover", id === hover);
+      marker.setZIndexOffset(id === active ? 1000 : id === hover ? 500 : 0);
+    });
+  }, [active, hover, pins, ready]);
+
+  return <div className="lodge-map" ref={host} data-testid="lodge-map" />;
+}
